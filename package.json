{
  "name": "nimbous-au-github-io",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css",
    "lint:html": "htmlhint index.html",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input",
    "lint:format": "prettier --check . --ignore-unknown",
    "format": "prettier --write . --ignore-unknown"
  },
  "devDependencies": {
    "htmlhint": "^1.1.4",
    "prettier": "^3.3.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1"
  }
}
