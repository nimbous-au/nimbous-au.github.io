{
  "name": "nimbous-au-github-io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "npm run lint:astro && npm run lint:css",
    "lint:astro": "eslint \"src/**/*.{astro,ts}\"",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "format": "prettier --write \"src/**/*.{astro,ts,md,css}\"",
    "check": "astro check"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/tailwind": "^5.1.3",
    "@typescript-eslint/parser": "^8.14.0",
    "astro": "^4.16.10",
    "eslint": "^9.14.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "sharp@0.33.5": true
  }
}
