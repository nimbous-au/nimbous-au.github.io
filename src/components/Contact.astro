---
import Icon from "./Icon.astro";
---

<section class="section" id="contact">
  <div class="wrap">
    <div class="contact__grid">
      <div class="reveal">
        <p class="eyebrow">Get in touch</p>
        <h2 class="sh">Let's talk about your project</h2>
        <p class="lead">
          Whether you're starting something new or untangling something old, we're happy to have an
          honest conversation about what might help.
        </p>
        <div class="contact__meta">
          <div class="contact__line">
            <Icon name="mail" class="contact__ico" />
            vishal.patel@nimbous.com.au
          </div>
          <div class="contact__line">
            <Icon name="pin" class="contact__ico" />
            Sydney, New South Wales
          </div>
        </div>
      </div>

      <form class="reveal" id="contactForm" novalidate>
        <div class="frow">
          <div class="fgrp">
            <label for="fname">Name</label>
            <input type="text" id="fname" name="name" placeholder="Your name" required />
          </div>
          <div class="fgrp">
            <label for="femail">Email</label>
            <input type="email" id="femail" name="email" placeholder="you@company.com" required />
          </div>
        </div>
        <div class="fgrp">
          <label for="fcompany">Company</label>
          <input type="text" id="fcompany" name="company" placeholder="Your company (optional)" />
        </div>
        <div class="fgrp">
          <label for="fmessage">Message</label>
          <textarea
            id="fmessage"
            name="message"
            placeholder="Tell us about your project…"
            required></textarea>
        </div>
        <button type="submit" class="btn-submit">
          Send message
          <Icon name="arrow-right" class="w-4 h-4" />
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: clamp(60px, 8vw, 100px);
    background: var(--bg);
  }
  .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .sh {
    font-family: "Syne", system-ui, sans-serif;
    font-size: clamp(1.65rem, 3.2vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .lead {
    margin-top: 14px;
    font-size: 1.0625rem;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.72;
    max-width: 50ch;
  }
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .contact__meta {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .contact__line {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .contact__ico {
    width: 15px;
    height: 15px;
    color: var(--accent);
    flex-shrink: 0;
    stroke-width: 2;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .frow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .fgrp {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  label {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--text);
  }
  input,
  textarea {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 10px 14px;
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 0.9375rem;
    color: var(--text);
    width: 100%;
    outline: none;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  input:focus,
  textarea:focus {
    border-color: var(--accent);
    background: var(--raised);
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--muted);
    opacity: 0.55;
  }
  textarea {
    resize: vertical;
    min-height: 130px;
  }
  .btn-submit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--dark);
    color: var(--bg);
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 11px 28px;
    border-radius: 3px;
    border: none;
    cursor: pointer;
    align-self: flex-start;
    transition: opacity 0.2s;
  }
  .btn-submit:hover {
    opacity: 0.8;
  }
  @media (max-width: 780px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .frow {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.getElementById("contactForm")!.addEventListener("submit", (e) => {
    e.preventDefault();
    const get = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
    const name = get("fname");
    const company = get("fcompany");
    const msg = get("fmessage");
    const subject = encodeURIComponent(`Project inquiry from ${name}`);
    const body = encodeURIComponent(`Name: ${name}\nCompany: ${company}\n\n${msg}`);
    window.location.href = `mailto:vishal.patel@nimbous.com.au?subject=${subject}&body=${body}`;
  });
</script>
