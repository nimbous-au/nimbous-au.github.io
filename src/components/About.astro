---
const values = [
  {
    title: "Quality over velocity",
    body: "We'd rather ship something right than something fast. Code written carefully costs less to operate and evolve.",
  },
  {
    title: "Small team, full ownership",
    body: "No sub-contracting. You work directly with the engineers solving the problem.",
  },
  {
    title: "Technology as a means",
    body: "We choose the simplest technology that solves the problem — not the most impressive one.",
  },
];
---

<section class="section" id="about">
  <div class="wrap">
    <div class="about__grid">
      <div class="reveal">
        <p class="eyebrow">About Nimbous</p>
        <h2 class="sh">A studio that takes the long view</h2>
        <p class="lead">
          Nimbous is a small team of engineers and architects based in Australia. We work closely
          with founders, product teams, and organisations who need software that's genuinely
          well-built.
        </p>
        <div class="values">
          {
            values.map(({ title, body }) => (
              <div class="value">
                <div class="value__pip" aria-hidden="true" />
                <div class="value__body">
                  <strong>{title}</strong>
                  {body}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="about__canvas-wrap reveal">
        <canvas class="about__canvas" id="dotCanvas" aria-hidden="true"></canvas>
        <div class="about__tag">
          Sydney, Australia
          <span>Est. 2015</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: clamp(60px, 8vw, 100px);
    background: var(--surface);
  }
  .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .sh {
    font-family: "Syne", system-ui, sans-serif;
    font-size: clamp(1.65rem, 3.2vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .lead {
    margin-top: 14px;
    font-size: 1.0625rem;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.72;
    max-width: 50ch;
  }
  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .values {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .value {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .value__pip {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 9px;
    flex-shrink: 0;
  }
  .value__body {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.65;
  }
  .value__body strong {
    display: block;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 3px;
  }
  .about__canvas-wrap {
    position: relative;
  }
  .about__canvas {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: block;
    background: var(--hero-bg);
    border-radius: 4px;
  }
  .about__tag {
    position: absolute;
    bottom: 18px;
    left: 18px;
    background: var(--raised);
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 10px 14px;
    border-radius: 3px;
    line-height: 1.3;
  }
  .about__tag span {
    display: block;
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--muted);
    margin-top: 2px;
  }
  @media (max-width: 780px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__canvas-wrap {
      order: -1;
    }
  }
</style>

<script>
  (function () {
    const canvas = document.getElementById("dotCanvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d")!;
    let W: number, H: number, raf: number;

    type Dot = {
      bx: number;
      by: number;
      x: number;
      y: number;
      phase: number;
      speed: number;
      amp: number;
      size: number;
    };
    let dots: Dot[] = [];

    function isDark() {
      const theme = document.documentElement.getAttribute("data-theme");
      if (theme === "dark") return true;
      if (theme === "light") return false;
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }

    function setup() {
      const rect = canvas!.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      W = rect.width;
      H = rect.height;
      canvas!.width = W * dpr;
      canvas!.height = H * dpr;
      ctx.scale(dpr, dpr);

      const cols = 12,
        rows = 9;
      dots = [];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = (c / (cols - 1)) * W * 0.85 + W * 0.075;
          const y = (r / (rows - 1)) * H * 0.7 + H * 0.15;
          dots.push({
            bx: x,
            by: y,
            x,
            y,
            phase: Math.random() * Math.PI * 2,
            speed: 0.3 + Math.random() * 0.4,
            amp: 1.5 + Math.random() * 2.5,
            size: 1.5 + Math.random() * 1,
          });
        }
      }
    }

    function draw(t: number) {
      ctx.clearRect(0, 0, W, H);
      const dark = isDark();
      const dotColor = dark ? "rgba(74,171,111,0.55)" : "rgba(46,125,82,0.45)";
      const lineColor = dark ? "rgba(74,171,111,0.12)" : "rgba(46,125,82,0.1)";
      const ts = t * 0.001;

      dots.forEach((d) => {
        d.x = d.bx + Math.sin(ts * d.speed + d.phase) * d.amp;
        d.y = d.by + Math.cos(ts * d.speed * 0.7 + d.phase) * d.amp * 0.7;
      });

      for (let i = 0; i < dots.length; i++) {
        for (let j = i + 1; j < dots.length; j++) {
          const dx = dots[i].x - dots[j].x,
            dy = dots[i].y - dots[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 70) {
            ctx.beginPath();
            ctx.moveTo(dots[i].x, dots[i].y);
            ctx.lineTo(dots[j].x, dots[j].y);
            ctx.strokeStyle = lineColor;
            ctx.lineWidth = 0.75;
            ctx.stroke();
          }
        }
      }

      dots.forEach((d) => {
        ctx.beginPath();
        ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
        ctx.fillStyle = dotColor;
        ctx.fill();
      });

      raf = requestAnimationFrame(draw);
    }

    setup();
    raf = requestAnimationFrame(draw);
    window.addEventListener("resize", () => {
      cancelAnimationFrame(raf);
      setup();
      raf = requestAnimationFrame(draw);
    });
  })();
</script>
